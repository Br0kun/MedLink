generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PATIENT
  DOCTOR
  LAB
  ADMIN
  ASSISTANT
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum AccessStatus {
  PENDING
  APPROVED
  DENIED
  REVOKED
  EXPIRED
}

enum Section {
  ANALYSIS
  PRESCRIPTION
  DIAGNOSIS
}

enum NotificationType {
  ACCESS_REQUEST
  ACCESS_GRANTED
  ACCESS_REVOKED
  LAB_RESULT_UPLOADED
  PRESCRIPTION_ADDED
  DOSSIER_VIEWED
  RESULT_ESCALATED
  ACCOUNT_APPROVED
  ACCOUNT_REJECTED
  BREAK_GLASS_ACCESS
  APPOINTMENT_BOOKED
  APPOINTMENT_CONFIRMED
  APPOINTMENT_CANCELLED
}

enum Specialty {
  GENERAL
  CARDIOLOGY
  NEUROLOGY
  DERMATOLOGY
  PEDIATRICS
  ONCOLOGY
  OPHTHALMOLOGY
  PSYCHIATRY
  ORTHOPEDICS
  OTHER
}

enum Priority {
  ROUTINE
  URGENT
  CRITICAL
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum BookedBy {
  PATIENT
  ASSISTANT
}

model User {
  id            String        @id @default(cuid())
  fullName      String
  email         String        @unique
  passwordHash  String
  role          Role
  accountStatus AccountStatus @default(ACTIVE)
  isActive      Boolean       @default(true)
  phoneNumber   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  patientProfile   Patient?
  doctorProfile    Doctor?
  labProfile       Lab?
  assistantProfile Assistant?
  notifications    Notification[]
  auditLogs        AuditLog[]
  sentMessages     ChatMessage[] @relation("SentMessages")
  receivedMessages ChatMessage[] @relation("ReceivedMessages")
}

model Patient {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id])
  dateOfBirth DateTime?
  bloodType   String?
  allergies   String[]
  dossier     MedicalRecord?
}

model Doctor {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id])
  specialty            Specialty @default(GENERAL)
  customSpecialty      String?
  licenseNumber        String?
  city                 String?
  isVerified           Boolean  @default(false)
  // Safety net settings (all DB-driven, no hardcoded defaults in code)
  routineDelayHours    Int      @default(12)
  quietHoursStart      String?
  quietHoursEnd        String?
  isQuietHoursEnabled  Boolean  @default(false)
  // Booking settings (all DB-driven)
  slotDurationMinutes  Int      @default(30)

  accessGrants    AccessGrant[]
  prescriptions   Prescription[]
  diagnoses       Diagnosis[]
  breakGlassLogs  BreakGlassLog[]
  assistants      Assistant[]
  schedule        DoctorSchedule[]
  appointments    Appointment[]
}

model Assistant {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  doctorId  String
  doctor    Doctor   @relation(fields: [doctorId], references: [id])
  createdAt DateTime @default(now())
}

model Lab {
  id         String     @id @default(cuid())
  userId     String     @unique
  user       User       @relation(fields: [userId], references: [id])
  labName    String?
  inpeCode   String?
  address    String?
  isVerified Boolean    @default(false)
  analyses   Analysis[]
}

model DoctorSchedule {
  id        String  @id @default(cuid())
  doctorId  String
  doctor    Doctor  @relation(fields: [doctorId], references: [id])
  dayOfWeek Int     // 0=Sunday, 1=Monday, ..., 6=Saturday
  startTime String  // "09:00" — stored as string, no hardcoded values
  endTime   String  // "17:00"
  isDayOff  Boolean @default(false)

  @@unique([doctorId, dayOfWeek])
}

model Appointment {
  id              String            @id @default(cuid())
  doctorId        String
  doctor          Doctor            @relation(fields: [doctorId], references: [id])
  patientName     String
  patientPhone    String
  reason          String?
  appointmentTime DateTime
  status          AppointmentStatus @default(PENDING)
  bookedBy        BookedBy          @default(PATIENT)
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model MedicalRecord {
  id          String   @id @default(cuid())
  patientId   String   @unique
  patient     Patient  @relation(fields: [patientId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  accessGrants   AccessGrant[]
  analyses       Analysis[]
  prescriptions  Prescription[]
  diagnoses      Diagnosis[]
  breakGlassLogs BreakGlassLog[]
}

// Permanent, append-only emergency-access audit trail. No update/delete
// operation is ever exposed for this model anywhere in the codebase —
// once created, a break-glass entry cannot be edited or removed.
model BreakGlassLog {
  id              String        @id @default(cuid())
  doctorId        String
  doctor          Doctor        @relation(fields: [doctorId], references: [id])
  medicalRecordId String
  medicalRecord   MedicalRecord @relation(fields: [medicalRecordId], references: [id])
  reason          String
  createdAt       DateTime      @default(now())
}

model AccessGrant {
  id              String        @id @default(cuid())
  medicalRecordId String
  medicalRecord   MedicalRecord @relation(fields: [medicalRecordId], references: [id])
  doctorId        String
  doctor          Doctor        @relation(fields: [doctorId], references: [id])
  status          AccessStatus  @default(PENDING)
  category        Specialty?
  scope           Section[]     @default([])
  requestedAt     DateTime      @default(now())
  respondedAt     DateTime?
  expiresAt       DateTime?
  fileId          String?
  file            Analysis?     @relation("FileAccessGrants", fields: [fileId], references: [id], onDelete: Cascade)
  prescriptionId  String?
  prescription    Prescription? @relation("PrescriptionAccessGrants", fields: [prescriptionId], references: [id], onDelete: Cascade)
  diagnosisId     String?
  diagnosis       Diagnosis?    @relation("DiagnosisAccessGrants", fields: [diagnosisId], references: [id], onDelete: Cascade)

  @@unique([medicalRecordId, doctorId, category, fileId, prescriptionId, diagnosisId])
}

model Analysis {
  id              String        @id @default(cuid())
  medicalRecordId String
  medicalRecord   MedicalRecord @relation(fields: [medicalRecordId], references: [id])
  labId           String
  lab             Lab           @relation(fields: [labId], references: [id])
  analysisType    String
  category        Specialty     @default(GENERAL)
  priority        Priority      @default(ROUTINE)
  summary         String?
  fileUrl         String?
  isReviewed      Boolean       @default(false)
  reviewedAt      DateTime?
  escalatedAt     DateTime?
  magicToken      String?       @unique
  lastNotifiedAt  DateTime?
  uploadedAt      DateTime      @default(now())

  accessGrants    AccessGrant[] @relation("FileAccessGrants")
}

model Prescription {
  id              String        @id @default(cuid())
  medicalRecordId String
  medicalRecord   MedicalRecord @relation(fields: [medicalRecordId], references: [id])
  doctorId        String
  doctor          Doctor        @relation(fields: [doctorId], references: [id])
  category        Specialty     @default(GENERAL)
  medications     String[]
  instructions    String?
  issuedAt        DateTime      @default(now())

  accessGrants    AccessGrant[] @relation("PrescriptionAccessGrants")
}

model Diagnosis {
  id              String        @id @default(cuid())
  medicalRecordId String
  medicalRecord   MedicalRecord @relation(fields: [medicalRecordId], references: [id])
  doctorId        String
  doctor          Doctor        @relation(fields: [doctorId], references: [id])
  category        Specialty     @default(GENERAL)
  title           String
  notes           String?
  diagnosedAt     DateTime      @default(now())

  accessGrants    AccessGrant[] @relation("DiagnosisAccessGrants")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  createdAt DateTime @default(now())
}

model ChatMessage {
  id              String   @id @default(cuid())
  senderId        String
  sender          User     @relation("SentMessages",      fields: [senderId],   references: [id])
  receiverId      String
  receiver        User     @relation("ReceivedMessages",  fields: [receiverId], references: [id])
  conversationKey String   // deterministic: sorted([senderId, receiverId]).join('_')
  content         String
  isRead          Boolean  @default(false)
  sentAt          DateTime @default(now())

  @@index([conversationKey])
  @@index([receiverId, isRead])
}